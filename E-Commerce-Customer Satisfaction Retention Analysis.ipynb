      ]
    },

    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 5. Data Cleaning – Payments Table"
      ]
    },

    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "payments.info()\\n",
        "payments.isnull().sum()\\n",
        "payments.duplicated().sum()\\n",
        "\\n",
        "# Standardize payment type naming\\n",
        "payments['payment_type'] = payments['payment_type'].str.capitalize()"
      ]
    },

    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Insight\\n",
