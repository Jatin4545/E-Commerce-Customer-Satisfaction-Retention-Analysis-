   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# FINAL INSIGHTS AND RECOMMENDATIONS\n",
    "# ============================================================================\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"FINAL INSIGHTS - Olist Customer Satisfaction Analysis\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "insights = [\n",
    "    (\"1\", \"Delivery Impact\", \n",
    "     \"Late deliveries increase bad review probability from 12% to 47% (3.9x increase)\"),\n",
