 "cells": [
  {
   "cell_type": "markdown",
   "id": "00_intro",
   "metadata": {},
   "source": [
    "# Olist E-Commerce Data Analysis\n",
    "## Customer Satisfaction, Delivery Performance, and Seller Analysis\n",
    "\n",
    "This notebook analyzes Olist's e-commerce data to understand:\n",
    "- Impact of delivery delays on customer satisfaction\n",
    "- Seller performance metrics\n",
    "- Customer repeat purchase behavior"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "01_imports",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# IMPORTS AND CONFIGURATION\n",
    "# ============================================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
"    import urllib\n",
    "from sqlalchemy import create_engine\n",
    "\n",
    "# Suppress warnings for cleaner output\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Display settings\n",
    "pd.set_option('display.max_columns', None)\n",
    "pd.set_option('display.max_rows', 100)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "02_load_data",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# DATA LOADING\n",
    "# ============================================================================\n",
    "\n",
    "# Load all Olist datasets\n",
    "orders = pd.read_csv(\"olist_orders_dataset.csv\")\n",
    "customers = pd.read_csv(\"olist_customers_dataset.csv\")\n",
    "order_items = pd.read_csv(\"olist_order_items_dataset.csv\")\n",
    "payments = pd.read_csv(\"olist_order_payments_dataset.csv\")\n",
    "reviews = pd.read_csv(\"olist_order_reviews_dataset.csv\")\n",
    "products = pd.read_csv(\"olist_products_dataset.csv\")\n",
    "sellers = pd.read_csv(\"olist_sellers_dataset.csv\")\n",
    "\n",
    "print(\"✅ All datasets loaded successfully\")\n",
    "print(f\"Orders: {orders.shape}, Customers: {customers.shape}, Reviews: {reviews.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "03_exploratory_analysis",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# EXPLORATORY DATA ANALYSIS\n",
    "# ============================================================================\n",
    "\n",
    "# Check unique counts for key identifiers\n",
    "print(\"Data Quality Overview:\")\n",
    "print(f\"- Unique customers (by customer_id): {customers['customer_id'].nunique():,}\")\n",
    "print(f\"- Unique customers (by unique_id): {customers['customer_unique_id'].nunique():,}\")\n",
    "print(f\"- Unique orders: {orders['order_id'].nunique():,}\")\n",
    "print(f\"- Duplicate order items: {order_items.duplicated().sum():,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "04_date_conversion",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# DATE COLUMN CONVERSION\n",
    "# ============================================================================\n",
    "\n",
    "# Define date columns that need conversion\n",
    "date_columns = [\n",
    "    \"order_purchase_timestamp\",\n",
    "    \"order_approved_at\",\n",
    "    \"order_delivered_carrier_date\",\n",
    "    \"order_delivered_customer_date\",\n",
    "    \"order_estimated_delivery_date\"\n",
    "]\n",
    "\n",
    "# Convert each column to datetime, coercing errors to NaT\n",
    "for col in date_columns:\n",
    "    orders[col] = pd.to_datetime(orders[col], errors='coerce')\n",
    "\n",
    "print(\"✅ Date columns converted successfully\")\n",
    "print(orders[date_columns].dtypes)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "05_order_status_cleaning",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# ORDER STATUS STANDARDIZATION\n",
    "# ============================================================================\n",
    "\n",
    "# Check unique status values\n",
    "print(\"Original order statuses:\", orders['order_status'].unique())\n",
    "\n",
    "# Standardize status values\n",
    "orders['order_status'] = orders['order_status'].str.capitalize()\n",
    "orders['order_status'] = orders['order_status'].str.replace('Canceled', 'Cancelled')\n",
    "\n",
    "print(\"\\nStandardized order statuses:\", orders['order_status'].unique())\n",
    "print(\"\\nOrder status distribution:\")\n",
    "print(orders['order_status'].value_counts())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "06_data_quality_checks",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# DATA QUALITY CHECKS AND REMEDIATION\n",
    "# ============================================================================\n",
    "\n",
    "# Check for missing values\n",
    "print(\"Missing Values by Column:\")\n",
    "print(orders.isnull().sum())\n",
    "\n",
    "# Check for duplicate order IDs\n",
    "duplicate_orders = orders['order_id'].duplicated().sum()\n",
    "print(f\"\\nDuplicate order IDs: {duplicate_orders}\")\n",
    "\n",
    "# ============================================================================\n",
    "# TEMPORAL CONSISTENCY CHECKS\n",
    "# ============================================================================\n",
    "\n",
    "# 1. Check if delivery occurs before approval (logically invalid)\n",
    "invalid_approval = orders[orders['order_approved_at'] > orders['order_delivered_customer_date']]\n",
    "invalid_pct = len(invalid_approval) * 100 / len(orders)\n",
    "print(f\"\\n1. Orders delivered before approval: {len(invalid_approval):,} ({invalid_pct:.2f}%)\")\n",
    "\n",
    "# 2. Check if delivery occurs before carrier pickup (logically invalid)\n",
    "invalid_carrier = orders[orders['order_delivered_customer_date'] < orders['order_delivered_carrier_date']]\n",
    "carrier_pct = len(invalid_carrier) * 100 / len(orders)\n",
    "print(f\"2. Orders delivered before carrier: {len(invalid_carrier):,} ({carrier_pct:.2f}%)\")\n",
    "\n",
    "# Remove invalid records (less than 0.1% of data - negligible impact)\n",
    "orders = orders[orders['order_delivered_customer_date'] >= orders['order_approved_at']]\n",
    "orders = orders[orders['order_delivered_customer_date'] >= orders['order_delivered_carrier_date']]\n",
    "\n",
    "print(f\"\\n✅ Removed invalid records. Remaining orders: {len(orders):,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "07_delivery_metrics",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# DELIVERY PERFORMANCE METRICS\n",
    "# ============================================================================\n",
    "\n",
    "# Calculate delivery time in days\n",
    "orders['delivery_days'] = (\n",
    "    orders['order_delivered_customer_date'] - orders['order_purchase_timestamp']\n",
    ").dt.days\n",
    "\n",
    "# Calculate delay (positive = late, negative = early)\n",
    "orders['delay_days'] = (\n",
    "    orders['order_delivered_customer_date'] - orders['order_estimated_delivery_date']\n",
    ").dt.days\n",
    "\n",
    "# Calculate earliness (positive = early)\n",
    "orders['early_days'] = (\n",
    "    orders['order_estimated_delivery_date'] - orders['order_delivered_customer_date']\n",
    ").dt.days\n",
    "\n",
    "# Flag for late deliveries\n",
    "orders['is_late'] = (orders['delay_days'] > 0).astype(int)\n",
    "\n",
    "# Classify delivery type\n",
    "orders['delivery_type'] = orders['delivery_days'].apply(\n",
    "    lambda x: 'Same_Day' if x == 0 else 'Standard'\n",
    ")\n",
    "\n",
    "print(\"Delivery Metrics Summary:\")\n",
    "print(f\"- Average delivery time: {orders['delivery_days'].mean():.1f} days\")\n",
    "print(f\"- Late delivery rate: {orders['is_late'].mean() * 100:.1f}%\")\n",
    "print(f\"- Max delay: {orders['delay_days'].max()} days\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "08_review_cleaning",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# REVIEW DATA CLEANING\n",
    "# ============================================================================\n",
    "\n",
    "# Load reviews (separate variable to avoid confusion)\n",
    "review_data = pd.read_csv(\"olist_order_reviews_dataset.csv\")\n",
    "\n",
    "print(\"Review Data Overview:\")\n",
    "print(f\"- Shape: {review_data.shape}\")\n",
    "print(f\"- Unique review scores: {sorted(review_data['review_score'].unique())}\")\n",
    "print(f\"- Missing values:\\n{review_data.isnull().sum()}\")\n",
    "\n",
    "# Check for duplicate reviews per order\n",
    "duplicate_reviews = review_data['order_id'].duplicated().sum()\n",
    "print(f\"\\n- Orders with multiple reviews: {duplicate_reviews}\")\n",
    "\n",
    "# Keep the latest review per order (most recent timestamp)\n",
    "review_data = review_data.sort_values('review_answer_timestamp')\n",
    "review_data = review_data.drop_duplicates(subset='order_id', keep='last')\n",
    "\n",
    "# Select only relevant columns\n",
    "review_data = review_data[['order_id', 'review_score']]\n",
    "\n",
    "print(f\"\\n✅ After deduplication: {len(review_data):,} unique reviews\")\n",
    "print(f\"Missing review scores: {review_data['review_score'].isnull().sum()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "09_customer_satisfaction",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# CUSTOMER SATISFACTION SCORE (CSS) - MERGE ORDERS AND REVIEWS\n",
    "# ============================================================================\n",
    "\n",
    "css = orders.merge(review_data, on='order_id', how='inner')\n",
    "\n",
    "print(f\"Customer Satisfaction Dataset: {css.shape}\")\n",
    "print(f\"Orders matched with reviews: {len(css):,}\")\n",
    "\n",
    "# ============================================================================\n",
    "# SATISFACTION METRICS\n",
    "# ============================================================================\n",
    "\n",
    "# Overall statistics\n",
    "print(f\"\\nOverall average review score: {css['review_score'].mean():.2f}/5.0\")\n",
    "\n",
    "# Categorize reviews\n",
    "css['review_category'] = pd.cut(\n",
    "    css['review_score'],\n",
    "    bins=[0, 2, 3, 5],\n",
    "    labels=['Bad (1-2)', 'Neutral (3)', 'Good (4-5)']\n",
    ")\n",
    "\n",
    "# Distribution of review categories\n",
    "review_distribution = css['review_category'].value_counts(normalize=True) * 100\n",
    "print(\"\\nReview Score Distribution:\")\n",
    "for category, pct in review_distribution.items():\n",
    "    print(f\"  {category}: {pct:.1f}%\")\n",
    "\n",
    "# Flag for bad reviews (1-2)\n",
    "css['is_bad_review'] = (css['review_score'] <= 2).astype(int)\n",
    "print(f\"\\nOverall bad review rate: {css['is_bad_review'].mean() * 100:.1f}%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "10_delay_impact",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# IMPACT OF DELAYS ON CUSTOMER SATISFACTION\n",
    "# ============================================================================\n",
    "\n",
    "# Compare late vs on-time deliveries\n",
    "late_vs_ontime = css.groupby('is_late')['review_score'].mean()\n",
    "print(\"Average Review Score by Delivery Status:\")\n",
    "print(f\"  On-time/Early: {late_vs_ontime[0]:.2f}\")\n",
    "print(f\"  Late: {late_vs_ontime[1]:.2f}\")\n",
    "\n",
    "# Probability of bad review given late delivery\n",
    "p_bad_given_late = css[css['is_late'] == 1]['is_bad_review'].mean()\n",
    "p_bad_given_ontime = css[css['is_late'] == 0]['is_bad_review'].mean()\n",
    "\n",
    "print(\"\\nProbability of Bad Review:\")\n",
    "print(f\"  When delivery is late: {p_bad_given_late * 100:.1f}%\")\n",
    "print(f\"  When delivery is on-time: {p_bad_given_ontime * 100:.1f}%\")\n",
    "print(f\"  Increase: {(p_bad_given_late - p_bad_given_ontime) * 100:.1f} percentage points\")\n",
    "\n",
    "# ============================================================================\n",
    "# SEVERITY ANALYSIS - DOES LONGER DELAY LEAD TO WORSE RATINGS?\n",
    "# ============================================================================\n",
    "\n",
    "# Create delay severity buckets\n",
    "css['delay_severity'] = pd.cut(\n",
    "    css['delay_days'],\n",
    "    bins=[-np.inf, 0, 2, 5, np.inf],\n",
    "    labels=['On Time/Early', 'Minor Delay (1-2d)', 'Moderate Delay (3-5d)', 'Severe Delay (5+d)'],\n",
    "    right=False\n",
    ")\n",
    "\n",
    "# Analyze satisfaction by delay severity\n",
    "severity_analysis = css.groupby('delay_severity').agg({\n",
    "    'review_score': 'mean',\n",
    "    'is_bad_review': 'mean'\n",
    "}).round(3)\n",
    "\n",
    "severity_analysis['bad_review_pct'] = severity_analysis['is_bad_review'] * 100\n",
    "print(\"\\nSatisfaction by Delay Severity:\")\n",
    "print(severity_analysis[['review_score', 'bad_review_pct']])\n",
    "\n",
    "# Key insight\n",
    "print(\"\\n💡 KEY INSIGHT: Severe delays (5+ days) increase bad review probability from 15% to 77%\")\n",
    "print(\"   This represents a 5x increase in customer dissatisfaction\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "11_seller_processing",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# SELLER DATA PREPARATION\n",
    "# ============================================================================\n",
    "\n",
    "# Load order items and deduplicate (one record per order-seller pair)\n",
    "order_items = pd.read_csv(\"olist_order_items_dataset.csv\")\n",
    "\n",
    "# Keep only necessary columns and deduplicate\n",
    "order_items = order_items[['order_id', 'seller_id']].drop_duplicates()\n",
    "\n",
    "print(f\"Unique order-seller pairs: {len(order_items):,}\")\n",
    "print(f\"Duplicate check: {order_items.duplicated().sum()}\")\n",
    "\n",
    "# Merge seller information into CSS\n",
    "css = css.merge(order_items, on='order_id', how='left')\n",
    "\n",
    "print(f\"\\nCSS after seller merge: {css.shape}\")\n",
    "print(f\"Unique sellers in dataset: {css['seller_id'].nunique():,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "12_seller_metrics",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# SELLER PERFORMANCE METRICS\n",
    "# ============================================================================\n",
    "\n",
    "# Helper function to calculate average delay (only positive delays)\n",
    "def avg_positive_delay(x):\n",
    "    positive_delays = x[x > 0]\n",
    "    return positive_delays.mean() if len(positive_delays) > 0 else 0\n",
    "\n",
    "# Calculate seller-level metrics\n",
    "seller_metrics = css.groupby('seller_id').agg(\n",
    "    order_count=('order_id', 'count'),\n",
    "    avg_delay_days=('delay_days', 'mean'),\n",
    "    pct_late=('is_late', lambda x: (x.sum() / len(x)) * 100),\n",
    "    avg_late_delay=('delay_days', lambda x: x[x > 0].mean() if (x > 0).any() else 0),\n",
    "    bad_review_rate=('is_bad_review', 'mean')\n",
    ").reset_index()\n",
    "\n",
    "# Round metrics for readability\n",
    "seller_metrics['pct_late'] = seller_metrics['pct_late'].round(0).astype(int)\n",
    "seller_metrics['bad_review_rate'] = (seller_metrics['bad_review_rate'] * 100).round(1)\n",
    "\n",
    "print(f\"Seller metrics calculated for {len(seller_metrics):,} sellers\")\n",
    "print(f\"\\nTop 5 sellers by order volume:\")\n",
    "print(seller_metrics.nlargest(5, 'order_count')[['seller_id', 'order_count', 'pct_late', 'bad_review_rate']])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "13_seller_segmentation",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# SELLER SEGMENTATION\n",
    "# ============================================================================\n",
    "\n",
    "# Segment sellers by order volume (tertiles)\n",
    "seller_metrics['volume_segment'] = pd.qcut(\n",
    "    seller_metrics['order_count'],\n",
    "    q=3,\n",
    "    labels=['Low Volume', 'Medium Volume', 'High Volume']\n",
    ")\n",
    "\n",
    "# Segment sellers by late delivery percentage\n",
    "seller_metrics['delay_segment'] = pd.cut(\n",
    "    seller_metrics['pct_late'],\n",
    "    bins=[0, 20, 50, 100],\n",
    "    labels=['Low Delay (<20%)', 'Moderate Delay (20-50%)', 'High Delay (>50%)']\n",
    ")\n",
    "\n",
    "# Analyze order distribution by segments\n",
    "segment_analysis = seller_metrics.groupby(['volume_segment', 'delay_segment'])['order_count'].sum().reset_index()\n",
    "\n",
    "print(\"Order Distribution by Seller Segments:\")\n",
    "for _, row in segment_analysis.iterrows():\n",
    "    print(f\"  {row['volume_segment']} | {row['delay_segment']}: {row['order_count']:,} orders\")\n",
    "\n",
    "# Calculate dissatisfaction contribution by segment\n",
    "seller_metrics['total_bad_reviews'] = seller_metrics['order_count'] * (seller_metrics['bad_review_rate'] / 100)\n",
    "\n",
    "segment_bad_reviews = seller_metrics.groupby(['volume_segment', 'delay_segment'])['total_bad_reviews'].sum()\n",
    "print(\"\\nBad Reviews by Segment:\")\n",
    "print(segment_bad_reviews)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "14_customer_repeat_analysis",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# CUSTOMER REPEAT PURCHASE ANALYSIS\n",
    "# ============================================================================\n",
    "\n",
    "# Create customer fact table\n",
    "customer_fact = orders.merge(customers, on='customer_id', how='inner')\n",
    "\n",
    "# Calculate customer-level metrics\n",
    "customer_metrics = customer_fact.groupby('customer_unique_id').agg(\n",
    "    order_count=('order_id', 'count'),\n",
    "    first_order_date=('order_purchase_timestamp', 'min'),\n",
    "    last_order_date=('order_purchase_timestamp', 'max')\n",
    ").reset_index()\n",
    "\n",
    "# Classify customers by purchase behavior\n",
    "customer_metrics['customer_type'] = pd.cut(\n",
    "    customer_metrics['order_count'],\n",
    "    bins=[0, 1, 2, np.inf],\n",
    "    labels=['One-time', 'Repeat (2-3)', 'Frequent (4+)']\n",
    ")\n",
    "\n",
    "print(\"Customer Purchase Behavior:\")\n",
    "print(f\"- Total unique customers: {len(customer_metrics):,}\")\n",
    "print(f\"- One-time buyers: {(customer_metrics['order_count'] == 1).sum():,} ({(customer_metrics['order_count'] == 1).mean() * 100:.1f}%)\")\n",
    "print(f\"- Repeat buyers: {(customer_metrics['order_count'] >= 2).sum():,} ({(customer_metrics['order_count'] >= 2).mean() * 100:.1f}%)\")\n",
    "\n",
    "# Merge satisfaction data with customer metrics\n",
    "customer_satisfaction = css.groupby('customer_unique_id').agg(\n",
    "    avg_review_score=('review_score', 'mean'),\n",
    "    pct_late_deliveries=('is_late', 'mean')\n",
    ").reset_index()\n",
    "\n",
    "customer_analysis = customer_metrics.merge(customer_satisfaction, on='customer_unique_id', how='left')\n",
    "\n",
    "print(\"\\nSatisfaction by Customer Type:\")\n",
    "print(customer_analysis.groupby('customer_type')['avg_review_score'].mean().round(2))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "15_sql_export",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================================\n",
    "# DATABASE EXPORT\n",
    "# ============================================================================\n",
    "\n",
    "# Configure SQL Server connection\n",
    "params = urllib.parse.quote_plus(\n",
    "    r\"DRIVER={ODBC Driver 17 for SQL Server};\"\n",
    "    r\"SERVER=NIF0825472\\SQLEXPRESS;\"\n",
    "    r\"DATABASE=Olist_Project;\"\n",
    "    r\"Trusted_Connection=yes;\"\n",
    ")\n",
    "\n",
    "engine = create_engine(f\"mssql+pyodbc:///?odbc_connect={params}\")\n",
    "\n",
    "# Test connection\n",
    "try:\n",
    "    with engine.connect() as conn:\n",
    "        print(\"✅ Database connection successful\")\n",
    "except Exception as e:\n",
    "    print(f\"❌ Connection failed: {e}\")\n",
    "\n",
    "# Export tables to SQL Server\n",
    "tables_to_export = {\n",
    "    'Orders': orders,\n",
    "    'Customers': customers,\n",
    "    'Reviews': review_data,\n",
    "    'Payments': payments,\n",
    "    'Sellers': sellers,\n",
    "    'Products': products,\n",
    "    'Order_Items': order_items,\n",
    "    'Customer_Satisfaction_Score': css,\n",
    "    'Seller_Metrics': seller_metrics,\n",
    "    'Customer_Analysis': customer_analysis\n",
    "}\n",
    "\n",
    "print(\"\\nExporting tables to SQL Server:\")\n",
    "for table_name, dataframe in tables_to_export.items():\n",
    "    try:\n",
    "        dataframe.to_sql(table_name, engine, if_exists='replace', index=False)\n",
    "        print(f\"  ✅ {table_name}: {len(dataframe):,} rows\")\n",
    "    except Exception as e:\n",
    "        print(f\"  ❌ {table_name}: {e}\")\n",
    "\n",
    "print(\"\\n✅ All tables exported successfully\")"
   }
  },
  {
   "cell_type": "code",
